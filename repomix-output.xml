  --color-primary: #1b5e20;
  --color-primary-dark: #00450d;
  --color-on-primary: #ffffff;
  --color-primary-container: #90d689;
  --color-secondary: #006e1c;
  --color-error: #ba1a1a;
  --color-error-container: #ffdad6;
  --color-on-error-container: #93000a;

  --radius-sm: 0.25rem;
  --radius-md: 0.75rem;
  --radius-lg: 1rem;
  --radius-xl: 1.5rem;
  --radius-full: 9999px;

  --space-xs: 4px;
  --space-sm: 8px;
  --space-md: 16px;
  --space-lg: 24px;
  --space-xl: 32px;
  --space-xxl: 48px;
  --page-padding: 20px;

  --shadow-2: 0 4px 12px rgba(38, 50, 56, 0.08);

  --font-sans:
    'Inter', system-ui, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;

  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 24px;
  color: var(--color-on-surface-variant);
  background: var(--color-background);
  color-scheme: light;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100svh;
  background: var(--color-background);
  color: var(--color-on-surface-variant);
}

#root {
  min-height: 100svh;
}

h1 {
  margin: 0;
  color: var(--color-on-surface);
  font-weight: 700;
  font-size: 28px;
  line-height: 36px;
}

a {
  color: var(--color-primary);
  text-decoration: none;
  font-weight: 500;
}

a:hover {
  text-decoration: underline;
}

/* Visible keyboard focus everywhere */
:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: 2px;
}

/* ---------- Form field ---------- */
.field {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.field > label {
  font-size: 14px;
  line-height: 20px;
  font-weight: 500;
  color: var(--color-on-surface);
}

.input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.input {
  width: 100%;
  height: 52px;
  padding: 0 14px;
  font-family: inherit;
  font-size: 16px;
  line-height: 24px;
  color: var(--color-on-surface);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  outline: none;
  transition:
    border-color 0.15s ease,
    box-shadow 0.15s ease;
}

.input::placeholder {
  color: var(--color-outline);
}

.input:focus {
  border-color: var(--color-primary);
  box-shadow: inset 0 0 0 1px var(--color-primary);
}

.input-has-icon {
  padding-left: 46px;
}

.input-has-adornment {
  padding-right: 48px;
}

.input-icon {
  position: absolute;
  left: 14px;
  display: inline-flex;
  color: var(--color-on-surface-variant);
  pointer-events: none;
}

.input-icon [class^='icon-'] {
  font-size: 20px;
  color: var(--color-primary-dark);
}

.input-adornment {
  position: absolute;
  right: 6px;
  display: inline-flex;
}

.input-wrap:focus-within .input-icon {
  color: var(--color-primary);
}

.field-invalid .input {
  border-color: var(--color-error);
}

.field-error {
  margin: var(--space-xs) 0 0;
  font-size: 12px;
  line-height: 16px;
  color: var(--color-error);
}

/* ---------- Button ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  min-height: 48px;
  padding: 0 var(--space-lg);
  font-family: inherit;
  font-size: 16px;
  line-height: 24px;
  font-weight: 600;
  border: 1px solid transparent;
  border-radius: var(--radius-md);
  cursor: pointer;
  transition:
    background-color 0.15s ease,
    color 0.15s ease,
    box-shadow 0.15s ease;
}

.btn-block {
  width: 100%;
}

.btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.btn-primary {
  color: var(--color-on-primary);
  background: var(--color-primary);
}

.btn-primary:hover:not(:disabled) {
  background: var(--color-primary-dark);
  box-shadow: var(--shadow-2);
}

.btn-secondary {
  color: var(--color-primary);
  background: var(--color-surface);
  border-color: var(--color-primary);
}

.btn-outline {
  color: var(--color-primary);
  background: transparent;
  border-color: var(--color-primary);
}

.btn-outline:hover:not(:disabled) {
  background: var(--color-primary);
  color: var(--color-on-primary);
}

@keyframes eco-spin {
  to {
    transform: rotate(360deg);
  }
}

.btn-spinner {
  width: 20px;
  height: 20px;
  border: 2px solid currentColor;
  border-top-color: transparent;
  border-radius: var(--radius-full);
  animation: eco-spin 0.7s linear infinite;
}

@media (prefers-reduced-motion: reduce) {
  .btn-spinner {
    animation-duration: 2s;
  }
}
</file>

