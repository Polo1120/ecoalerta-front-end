import { Navigate, Outlet, useLocation } from 'react-router-dom'
import { isAuthenticated } from '../utils/auth'

export function RequireAuth() {
  const location = useLocation()

  if (!isAuthenticated()) {
    return <Navigate to="/login" replace state={{ from: location }} />
  }

  return <Outlet />
}
